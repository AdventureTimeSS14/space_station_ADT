reagent-name-eldritch = eldritch essence
reagent-desc-eldritch = A strange liquid that defies the laws of physics. It re-energizes and heals those who can see beyond this fragile reality, but is incredibly harmful to the closed-minded.

reagent-comp-condition-heretic-or-ghoul = heretic or ghoul

reagent-physical-desc-eldritch = eldritch

flavor-complex-eldritch = Ag'hsj'saje'sh

reagent-name-ether = newborn ether
reagent-desc-ether = Foul ichor that knits the drinker whole, then drags them into eldritch slumber.
reagent-physical-desc-ether = swirling green ichor

reagent-name-eldritch-essence = eldritch essence
reagent-desc-eldritch-essence = Pure essence extracted from the crucible. Refills an eldritch flask.
reagent-physical-desc-eldritch-essence = viscous dark green liquid

reagent-name-crucible-soul = crucible soul
reagent-desc-crucible-soul = The soul of the crucible, distilled into liquid form. Grants the ability to phase through solid matter.
reagent-physical-desc-crucible-soul = swirling violet mist

reagent-name-clarity = dusk and dawn
reagent-desc-clarity = A dull yellow liquid. It seems to fade in and out with regularity. Allows you to see through walls and objects.
reagent-physical-desc-clarity = clear

reagent-name-wounded-soldier = wounded soldier
reagent-desc-wounded-soldier = A crimson tincture that draws power from pain. The more you are wounded, the stronger and faster you strike.
reagent-physical-desc-wounded-soldier = thick dark red liquid

flavor-complex-clarity = like eyes
flavor-complex-rust = corroded metal

reagent-name-eldritch-rust = eldritch rust
reagent-desc-eldritch-rust = A corrosive metallic substance that devours everything it touches. Causes rust, blindness, and intense pain to the unworthy.
reagent-physical-desc-rusty = rusty

crucible-soul-effect-examine-message = [color=purple]{CAPITALIZE(SUBJECT($target))} is insubstantial and intangible![/color]
wounded-soldier-effect-examine-message = [color=red]{CAPITALIZE(SUBJECT($target))} is covered in pulsating wounds![/color]
