ent-ADTDrill = mining drill
    .desc = An enormous industrial drill for harvesting ore. Requires two anchored braces to operate.

ent-ADTDrillBrace = mining drill brace
    .desc = A machinery brace for an industrial drill. It looks easily two feet thick.

drill-start = The drill lurches downwards, grinding noisily
drill-stop = The drill shudders to a grinding halt
drill-error-bracing = Insufficient bracing or the drill is not anchored
drill-error-power = The drill is unpowered
drill-error-storage = Insufficient storage space
drill-error-lavaland = The drill can only be used on lavaland
drill-error-breakdown = The drill mechanism jammed. A manual restart is required
drill-override-reset = You hit the manual override and reset the drill's error checking
drill-panel-open = Close the maintenance panel before operating the drill
drill-unload-verb = Unload drill
drill-unload-empty = The drill's storage is empty
drill-unload-no-box = You must move an ore box up to the drill before you can unload it
drill-unload-success = You unloaded { $count } items into the ore box
drill-unload-full = The ore box is full. Some items were left in the drill
drill-examine-braces = Braces: { $count }/{ $required }
drill-examine-active = The drill is running
drill-examine-error = The drill is stopped due to an error. A manual override is required