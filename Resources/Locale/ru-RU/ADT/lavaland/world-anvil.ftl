ent-ADTStoneTileSurrounding = { ent-ADTStoneTile }
    .desc = { ent-ADTStoneTile.desc }
ent-ADTStoneTileSurroundingCracked = { ent-ADTStoneTile }
    .desc = { ent-ADTStoneTile.desc }
ent-ADTStoneTileCenterCracked = { ent-ADTStoneTile }
    .desc = { ent-ADTStoneTile.desc }
ent-ADTStoneTileSlab = { ent-ADTStoneTile }
    .desc = { ent-ADTStoneTile.desc }

ent-ADTAshTotem = пепельный тотем
    .desc = Массивный каменный столб с прикреплённым к нему черепом убитого зверя. Кажется, вы зашли в охотничьи угодья пеплоходцев.
