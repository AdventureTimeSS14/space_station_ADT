ent-BaseMobGhoul = { ent-SimpleMobBase }
    .desc = { ent-SimpleMobBase.desc }
ent-MobGhoulStalker = сталкер
    .desc = Мерзость, собранная из разнообразных останков. Ее внешний вид слегка меняется каждый раз, когда вы моргаете.
ent-MobGhoulProphet = пророк
    .desc = Мерзость, сшитая из нескольких отрубленных рук и одного опухшего глаза.
ent-MobGhoulFireShark = огнеакула
    .desc = Это древняя карликовая космическая акула, также известная как огненная акула.
ent-MobGhoulRustWalker = ржавый ходок
    .desc = Скрежещущая, лязгающая конструкция, которая с каждым шагом в доспехах вымывает жизнь из окружающей среды.
    .suffix = НЕ МАППИТЬ

ent-MobGhoulMirrorMaid = горничная в зеркале
    .desc = Парящий сгусток морозного воздуха. Взгляд на неё заставляет её слегка мерцать.
ent-MobGhoulAshSpirit = дух пепла
    .desc = Воплощение пепла, оставляющее за собой вечное облако быстро гаснущих угольков.
ent-MobShatteredRisen = расколотый восставший
    .desc = Труп, возвращённый к подобию жизни холодной рвущей силой. Его руки — жестокие гнёзда острых костяных осколков.

ent-MobGhoulStalkerLock = { ent-MobGhoulStalker }
    .desc = { ent-MobGhoulStalker.desc }
ent-MobGhoulProphetLock = { ent-MobGhoulProphet }
    .desc = { ent-MobGhoulProphet.desc }
ent-MobGhoulFireSharkLock = { ent-MobGhoulFireShark }
    .desc = { ent-MobGhoulFireShark.desc }
ent-MobGhoulRustWalkerLock = { ent-MobGhoulRustWalker }
    .desc = { ent-MobGhoulRustWalker.desc }
