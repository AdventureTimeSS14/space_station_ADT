uniform sampler2D displacementMap;
uniform highp float displacementSize;
uniform highp vec4 displacementUV;

varying highp vec2 displacementUVOut;

uniform sampler2D clipMap;
uniform highp vec4 clipUV;
uniform highp vec4 clipArms;
uniform highp vec4 clipLegs;

varying highp vec2 clipUVOut;

highp float limbClipped(highp float id) {
    if (id < 0.5) return 0.0;
    if (id < 1.5) return clipArms.x;
    if (id < 2.5) return clipArms.y;
    if (id < 3.5) return clipArms.z;
    if (id < 4.5) return clipArms.w;
    if (id < 5.5) return clipLegs.x;
    if (id < 6.5) return clipLegs.y;
    if (id < 7.5) return clipLegs.z;
    if (id < 8.5) return clipLegs.w;
    if (id < 9.5) return clipArms.x * clipArms.y;
    if (id < 10.5) return clipArms.z * clipArms.w;
    if (id < 11.5) return clipLegs.x * clipLegs.y;
    return clipLegs.z * clipLegs.w;
}

void vertex() {
    displacementUVOut = mix(displacementUV.xy, displacementUV.zw, tCoord2);
    clipUVOut = mix(clipUV.xy, clipUV.zw, tCoord2);
}

void fragment() {
    highp vec4 displacementSample = texture2D(displacementMap, displacementUVOut);
    highp vec2 displacementValue = (displacementSample.xy - vec2(128.0 / 255.0)) / (1.0 - 128.0 / 255.0);
    COLOR = zTexture(UV + displacementValue * TEXTURE_PIXEL_SIZE * displacementSize * vec2(1.0, -1.0));
    COLOR.a *= displacementSample.a;
    if (limbClipped(floor(texture2D(clipMap, clipUVOut).r * 25.5 + 0.5)) > 0.5)
        COLOR.a = 0.0;
}
