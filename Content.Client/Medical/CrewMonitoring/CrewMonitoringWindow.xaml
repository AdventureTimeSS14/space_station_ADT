<ui:CrewMonitoringWindow xmlns="https://spacestation14.io"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               xmlns:ui="clr-namespace:Content.Client.Medical.CrewMonitoring"
               xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
               x:Class="Content.Client.Medical.CrewMonitoring.CrewMonitoringWindow"
               SetSize="1280 760"
               MinSize="1000 560"
               MouseFilter="Stop">
    <!-- Outer bezel: color comes from PdaBorderColor on the opened monitor -->
    <PanelContainer Name="Background" Access="Public" StyleClasses="PdaBackgroundRect"/>
    <PanelContainer Name="AccentH" Access="Public" Margin="-1 170 -2 170" StyleClasses="PdaBackground" Visible="False"/>
    <PanelContainer Name="AccentV" Access="Public" Margin="220 -1 220 -1" StyleClasses="PdaBackground" Visible="False"/>
    <PanelContainer Name="Border" StyleClasses="PdaBorderRect"/>

    <BoxContainer Orientation="Vertical" HorizontalExpand="True" VerticalExpand="True">
        <!-- Header -->
        <BoxContainer SetHeight="26" Margin="4 2 8 0" Orientation="Horizontal">
            <Control HorizontalExpand="True"/>
            <TextureButton Name="CloseButton" StyleClasses="windowCloseButton"
                           VerticalAlignment="Center" Margin="0 4 4 0"/>
        </BoxContainer>

        <!-- Content -->
        <Control Margin="18 0" RectClipContent="True" VerticalExpand="True" HorizontalExpand="True">
            <PanelContainer Name="ContentBorder" StyleClasses="PdaBackground"/>
            <Control Margin="3 3" HorizontalExpand="True" VerticalExpand="True">
                <ui:CrtScanlineBackground Name="ContentBackground" HorizontalExpand="True" VerticalExpand="True"/>
                <BoxContainer Name="ContentsContainer" Orientation="Vertical" HorizontalExpand="True" VerticalExpand="True"
                              StyleClasses="PdaContent" RectClipContent="True" Margin="2">
                    <BoxContainer Orientation="Horizontal" VerticalExpand="True" HorizontalExpand="True" MinHeight="0" SeparationOverride="0">
                        <PanelContainer Name="LeftPanelFrame" HorizontalExpand="True" VerticalExpand="True" Margin="8 8 4 8" MinHeight="0">
                            <BoxContainer Orientation="Vertical" HorizontalExpand="True" VerticalExpand="True" Margin="6" MinHeight="0">
                                <controls:StripeBack Name="HeaderStripe">
                                    <BoxContainer Orientation="Horizontal" MinHeight="38">
                                        <Label Name="StationName" Text="{Loc crew-monitoring-ui-no-station-label}"
                                               VerticalAlignment="Center" Margin="10 4" StyleClasses="LabelHeading"/>
                                        <BoxContainer Name="ServerStatusContainer" Orientation="Horizontal"
                                                      HorizontalAlignment="Right" HorizontalExpand="True"
                                                      VerticalAlignment="Center" Margin="8 4" Visible="false"/>
                                    </BoxContainer>
                                </controls:StripeBack>
                                <BoxContainer Orientation="Vertical" VerticalExpand="True" HorizontalExpand="True" Margin="0 6 0 0">
                                    <ui:CrewMonitoringNavMapControl Name="NavMap" HorizontalExpand="True" VerticalExpand="True"/>
                                    <PanelContainer Name="MapPlaceholder" Visible="false" HorizontalExpand="True" VerticalExpand="True">
                                        <BoxContainer Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Label Text="{Loc crew-monitoring-ui-select-server-label}"
                                                   HorizontalAlignment="Center"
                                                   StyleClasses="LabelHeading" FontColorOverride="Gray"/>
                                            <Label Text="{Loc crew-monitoring-ui-scan-initializing}"
                                                   HorizontalAlignment="Center" Margin="0 8 0 0" FontColorOverride="DimGray"/>
                                        </BoxContainer>
                                    </PanelContainer>
                                </BoxContainer>
                            </BoxContainer>
                        </PanelContainer>

                        <PanelContainer Name="PanelDivider" SetWidth="2" VerticalExpand="True" Margin="0 12"/>

                        <PanelContainer Name="RightPanelFrame" SetWidth="430" Margin="4 8 8 8" VerticalExpand="True" MinHeight="0">
                            <BoxContainer Orientation="Vertical" SetWidth="418" Margin="6" Name="RightPanel" VerticalExpand="True" MinHeight="0">
                            <!-- Before scan: one big button and progress bar -->
                            <BoxContainer Name="StartScanPanel" Orientation="Vertical" VerticalExpand="True">
                                <Button Name="StartScanButton" Text="{Loc crew-monitoring-ui-start-scan}" HorizontalExpand="True"
                                        VerticalExpand="True" Margin="8" StyleClasses="BigButton"/>
                                <PanelContainer Name="ScanLoadingPanel" Visible="false" VerticalExpand="True" Margin="8">
                                    <BoxContainer Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  HorizontalExpand="True">
                                        <Label Text="{Loc crew-monitoring-ui-scan-title}" Align="Center"
                                               StyleClasses="LabelHeading" Margin="0 0 0 12"/>
                                        <Label Name="ScanLoadingStatus" Text="{Loc crew-monitoring-ui-scan-initializing}"
                                               Align="Center" FontColorOverride="LightGray" Margin="0 0 0 8"/>
                                        <ProgressBar Name="ScanProgressBar" MinValue="0" MaxValue="1" Value="0"
                                                     HorizontalExpand="True" SetHeight="18"/>
                                        <Label Name="ScanLoadingPercent" Text="0%" Align="Center"
                                               FontColorOverride="Gray" Margin="0 6 0 0"/>
                                    </BoxContainer>
                                </PanelContainer>
                            </BoxContainer>

                            <!-- After scan: tabs Датчики / Сервера -->
                            <TabContainer Name="MainTabs" VerticalExpand="True" Visible="false" MinHeight="0">
                                <BoxContainer Orientation="Vertical" VerticalExpand="True" MinHeight="0">
                                    <LineEdit Name="SearchLineEdit" HorizontalExpand="True"
                                              PlaceHolder="{Loc crew-monitoring-ui-filter-line-placeholder}" />
                                    <ScrollContainer Name="SensorScroller"
                                                     VerticalExpand="True"
                                                     HorizontalExpand="True"
                                                     Margin="8, 8, 8, 8">
                                        <BoxContainer Name="SensorsTable"
                                                       Orientation="Vertical"
                                                       HorizontalExpand="True"
                                                       Margin="0 0 10 0">
                                        </BoxContainer>
                                        <Label Name="NoServerLabel"
                                               Text="{Loc crew-monitoring-ui-no-server-label}"
                                               StyleClasses="LabelHeading"
                                               FontColorOverride="Red"
                                               HorizontalAlignment="Center"
                                               Visible="false"/>
                                    </ScrollContainer>
                                </BoxContainer>
                                <ScrollContainer Name="ServersTabScroller" VerticalExpand="True" HorizontalExpand="True" Margin="8">
                                    <BoxContainer Name="ServersListContainer" Orientation="Vertical" HorizontalExpand="True"/>
                                </ScrollContainer>
                            </TabContainer>
                        </BoxContainer>
                        </PanelContainer>
                    </BoxContainer>
                </BoxContainer>
            </Control>
        </Control>

        <!-- Footer -->
        <BoxContainer Orientation="Horizontal" SetHeight="28" Margin="10 0 10 0" VerticalAlignment="Center">
            <Label Text="{Loc crew-monitoring-ui-flavor-left-label}" StyleClasses="WindowFooterText" />
            <Label Text="{Loc crew-monitoring-ui-flavor-right-label}" StyleClasses="WindowFooterText"
                   HorizontalAlignment="Right" HorizontalExpand="True" Margin="0 0 5 0"/>
            <TextureRect StyleClasses="NTLogoDark" Stretch="KeepAspectCentered"
                         VerticalAlignment="Center" HorizontalAlignment="Right" SetSize="19 19"/>
        </BoxContainer>
    </BoxContainer>
</ui:CrewMonitoringWindow>
