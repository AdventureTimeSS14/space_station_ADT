<Control xmlns="https://spacestation14.io"
         xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls">
    <BoxContainer Orientation="Vertical" SeparationOverride="8" MinWidth="260">
        <Label Text="{Loc 'queue-games-title'}" StyleClasses="LabelHeading" Align="Center"/>
        <Label Name="ScoreLabel" Align="Center"/>
        <Label Name="StatusLabel" Align="Center" FontColorOverride="#b0b0b0"/>
        <GridContainer Name="Board" Columns="3" HorizontalAlignment="Center"
                       HSeparationOverride="4" VSeparationOverride="4"/>
        <Button Name="SearchButton" HorizontalExpand="True"/>
        <controls:HighDivider/>
        <BoxContainer Orientation="Horizontal" SeparationOverride="8">
            <AnimatedTextureRect Name="SlotSprite" VerticalAlignment="Center" MinSize="64 64"/>
            <BoxContainer Orientation="Vertical" HorizontalExpand="True" VerticalAlignment="Center" SeparationOverride="4">
                <Label Name="SlotLabel" HorizontalExpand="True"/>
                <Button Name="SpinButton" Text="{Loc 'queue-games-spin'}" HorizontalExpand="True"/>
            </BoxContainer>
        </BoxContainer>
    </BoxContainer>
</Control>
