<controls:FancyWindow xmlns="https://spacestation14.io"
            xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
            xmlns:gfx="clr-namespace:Robust.Client.Graphics;assembly=Robust.Client"
            Title="{Loc 'music-recorder-menu-title'}"
            MinSize="460 540"
            SetSize="480 560">
    <BoxContainer Orientation="Vertical" SeparationOverride="8" Margin="6">
        <PanelContainer>
            <PanelContainer.PanelOverride>
                <gfx:StyleBoxFlat BackgroundColor="#1b2430" BorderThickness="1" BorderColor="#3e8f8a"/>
            </PanelContainer.PanelOverride>
            <BoxContainer Orientation="Vertical" Margin="12 10">
                <Label Text="{Loc 'music-recorder-deck-label'}" FontColorOverride="#8fd9d2" />
                <Label Name="CassetteNameLabel" Text="{Loc 'music-recorder-no-cassette'}" Margin="0 4 0 0" />
                <Label Name="CassetteMetaLabel" Text="{Loc 'music-recorder-insert-hint'}" FontColorOverride="#9aa4b2" Margin="0 2 0 0" />
            </BoxContainer>
        </PanelContainer>

        <Button Name="SlotButton" Text="{Loc 'music-recorder-insert'}" />

        <BoxContainer Orientation="Horizontal" SeparationOverride="6">
            <LineEdit Name="NameEdit"
                      PlaceHolder="{Loc 'music-recorder-name-placeholder'}"
                      HorizontalExpand="True" />
            <Button Name="RenameButton" Text="{Loc 'music-recorder-rename'}" Disabled="True" MinWidth="130" />
        </BoxContainer>

        <Label Text="{Loc 'music-recorder-tracks-label'}" />
        <PanelContainer VerticalExpand="True" MinSize="0 180">
            <PanelContainer.PanelOverride>
                <gfx:StyleBoxFlat BackgroundColor="#141820" BorderThickness="1" BorderColor="#2c3442"/>
            </PanelContainer.PanelOverride>
            <ScrollContainer HScrollEnabled="False" HorizontalExpand="True" VerticalExpand="True" Margin="6">
                <BoxContainer Name="TrackList" Access="Public" Orientation="Vertical" SeparationOverride="4" />
            </ScrollContainer>
        </PanelContainer>

        <Button Name="UploadButton" Text="{Loc 'music-recorder-upload'}" Disabled="True" />
        <Label Name="HintLabel" Text="{Loc 'music-recorder-upload-hint'}" FontColorOverride="#9aa4b2" />
        <Label Name="StatusLabel" />
    </BoxContainer>
</controls:FancyWindow>
