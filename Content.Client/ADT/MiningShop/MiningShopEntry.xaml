<cc:MiningShopEntry
    xmlns="https://spacestation14.io"
    xmlns:cc="clr-namespace:Content.Client.ADT.MiningShop"
    HorizontalExpand="True"
    SetHeight="34"
    RectClipContent="True">
    <BoxContainer Orientation="Horizontal" SeparationOverride="4" VerticalExpand="True">
        <LayeredTextureRect Name="Texture" Access="Public"
                            SetSize="32 32" CanShrink="True" Stretch="KeepAspectCentered"
                            VerticalAlignment="Center" />
        <Label Name="Price" Access="Public" SetWidth="56" Align="Right" ClipText="True"
               StyleClasses="LabelKeyText" VerticalAlignment="Center" />
        <Label Name="Capacity" Access="Public" SetWidth="40" Align="Right" ClipText="True"
               StyleClasses="LabelSubText" VerticalAlignment="Center" />
        <cc:MiningShopPanel Name="Panel" Access="Public" VerticalExpand="True" />
        <Button Text="?" Name="TooltipLabel" Access="Public" ModulateSelfOverride="#00000000"
                SetWidth="26" VerticalExpand="True" />
    </BoxContainer>
</cc:MiningShopEntry>
