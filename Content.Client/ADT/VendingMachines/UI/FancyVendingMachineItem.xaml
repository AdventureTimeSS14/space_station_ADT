<PanelContainer xmlns="https://spacestation14.io"
                xmlns:adt="clr-namespace:Content.Client.ADT.UserInterface.Controls.FancyButton"
                xmlns:ui="clr-namespace:Content.Client.ADT.UserInterface.Controls"
                Name="EntryPanel"
                StyleClasses="VendingEntryPanel"
                HorizontalExpand="True"
                Margin="0 0 0 2">

    <BoxContainer Orientation="Horizontal"
                  HorizontalExpand="True"
                  Margin="8 3">

        <Button Name="InfoButton"
                Text="?"
                ModulateSelfOverride="#00000000"
                MinSize="26 26"
                Margin="0 0 4 0"
                VerticalAlignment="Center"/>

        <EntityPrototypeView
                Name="ItemPrototype"
                MinSize="41 41"
                Scale="1.3 1.3"
                Margin="0 0 8 0"
                VerticalAlignment="Center"/>

        <ui:ADTMarqueeLabel Name="NameLabel"
                            HorizontalExpand="True"
                            VerticalAlignment="Center"
                            Margin="0 0 6 0"/>

        <RichTextLabel Name="CountLabel"
                       StyleClasses="VendingEntryCountLabel"
                       VerticalAlignment="Center"/>

        <adt:FancyButton
                Name="BuyButton"
                MinSize="70 24"
                Margin="8 0 0 0"
                VerticalAlignment="Center">
            <RichTextLabel Name="CostLabel"
                           StyleClasses="VendingEntryPriceLabel"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
        </adt:FancyButton>
    </BoxContainer>
</PanelContainer>
