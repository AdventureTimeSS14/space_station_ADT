<controls:FancyWindow
    xmlns="https://spacestation14.io"
    xmlns:gfx="clr-namespace:Robust.Client.Graphics;assembly=Robust.Client"
    xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
    MinSize="740 480"
    SetSize="900 600">
    <BoxContainer
        Name="MainContainer"
        Orientation="Vertical"
        VerticalExpand="True"
        HorizontalExpand="True"
        Margin="4"
        SeparationOverride="4">
        <BoxContainer
            Orientation="Horizontal"
            HorizontalExpand="True">
            <Label
                Name="UserBalanceLabel"
                HorizontalExpand="True"
                VerticalAlignment="Center"/>
            <Label
                Name="CreditsLabel"
                VerticalAlignment="Center"
                Margin="0 0 8 0"/>
            <Button
                Name="WithdrawButton"
                Text="{Loc 'store-ui-default-withdraw-text'}"/>
        </BoxContainer>
        <PanelContainer>
            <PanelContainer.PanelOverride>
                <gfx:StyleBoxFlat BackgroundColor="#1B1B1E"/>
            </PanelContainer.PanelOverride>
            <LineEdit
                Name="SearchBar"
                PlaceHolder="{Loc 'vending-machine-component-search-filter'}"
                HorizontalExpand="True"
                Margin="8 6"/>
        </PanelContainer>
        <BoxContainer
            Orientation="Horizontal"
            VerticalExpand="True">
            <PanelContainer
                Name="CategoryBarPanel"
                SetWidth="200"
                Margin="0 0 4 0"
                Visible="False">
                <PanelContainer.PanelOverride>
                    <gfx:StyleBoxFlat BackgroundColor="#1B1B1E"/>
                </PanelContainer.PanelOverride>
                <BoxContainer
                    Name="CategoryBar"
                    Orientation="Vertical"
                    Margin="4"/>
            </PanelContainer>
            <PanelContainer
                VerticalExpand="True"
                HorizontalExpand="True">
                <PanelContainer.PanelOverride>
                    <gfx:StyleBoxFlat BackgroundColor="#1B1B1E"/>
                </PanelContainer.PanelOverride>
                <ScrollContainer VerticalExpand="True" HScrollEnabled="False">
                    <BoxContainer
                        Name="VendingContents"
                        Orientation="Vertical"
                        HorizontalExpand="True"
                        VerticalExpand="True"
                        RectClipContent="True"/>
                </ScrollContainer>
            </PanelContainer>
        </BoxContainer>
    </BoxContainer>
</controls:FancyWindow>