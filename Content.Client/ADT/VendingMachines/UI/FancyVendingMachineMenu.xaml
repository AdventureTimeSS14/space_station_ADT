<controls:FancyWindow
    xmlns="https://spacestation14.io"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
    MinSize="860 480"
    SetSize="860 640">
    <BoxContainer Name="MainContainer" Orientation="Vertical" Margin="10 8 10 10">

        <PanelContainer StyleClasses="VendingHeaderPanel" Margin="0 0 0 8">
            <BoxContainer Orientation="Vertical" Margin="12 10">
                <Label Name="UserBalanceLabel" StyleClasses="VendingBalanceLabel" Margin="0 0 0 6"/>
                <BoxContainer Orientation="Horizontal">
                    <Label Name="CreditsLabel" StyleClasses="VendingCreditsLabel" VerticalAlignment="Center"/>
                    <Control HorizontalExpand="True"/>
                    <Button Name="WithdrawButton"
                            Text="{Loc 'store-ui-default-withdraw-text'}"
                            MinSize="0 26"
                            VerticalAlignment="Center"/>
                </BoxContainer>
            </BoxContainer>
        </PanelContainer>
        <PanelContainer StyleClasses="VendingHeaderAccent" SetHeight="3" Margin="0 0 0 8"/>

        <PanelContainer StyleClasses="VendingSearchBar" Margin="0 0 0 8">
            <LineEdit Name="SearchBar"
                      PlaceHolder="{Loc 'vending-machine-component-search-filter'}"
                      StyleClasses="VendingSearchInput"
                      HorizontalExpand="True"
                      Margin="10 8"/>
        </PanelContainer>

        <BoxContainer Orientation="Horizontal" VerticalExpand="True">

            <PanelContainer Name="CategoryBarPanel" StyleClasses="VendingCategoryBar" SetWidth="200" Margin="0 0 8 0" Visible="False">
                <BoxContainer Name="CategoryBar" Orientation="Vertical" Margin="6 4"/>
            </PanelContainer>

            <ScrollContainer VerticalExpand="True" HorizontalExpand="True" HScrollEnabled="False" Margin="0 0 4 0">
                <BoxContainer Name="VendingContents" Orientation="Vertical" HorizontalExpand="True" Margin="0 0 4 0"/>
            </ScrollContainer>
        </BoxContainer>

        <!-- Footer -->
        <PanelContainer StyleClasses="VendingFooterPanel" Margin="0 8 0 0">
            <BoxContainer Orientation="Horizontal" Margin="10 6">
                <Label Text="{Loc 'vending-machine-flavor-left'}" StyleClasses="VendingFooterText"/>
                <Control HorizontalExpand="True"/>
                <Label Text="{Loc 'vending-machine-flavor-right-new'}" StyleClasses="VendingFooterText"/>
            </BoxContainer>
        </PanelContainer>
    </BoxContainer>
</controls:FancyWindow>
