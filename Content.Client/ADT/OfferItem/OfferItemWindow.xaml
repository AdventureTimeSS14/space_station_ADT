<controls:FancyWindow xmlns="https://spacestation14.io"
                      xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
                      Title="{Loc 'offer-item-window-title'}"
                      MinSize="300 150"
                      SetSize="320 160"
                      Resizable="False">
    <BoxContainer Orientation="Vertical" Margin="8">
        <BoxContainer Orientation="Horizontal" VerticalExpand="True">
            <SpriteView Name="ItemView" SetSize="64 64" Scale="2 2" OverrideDirection="South" Margin="0 0 8 0" />
            <RichTextLabel Name="OfferText" HorizontalExpand="True" VerticalAlignment="Center" />
        </BoxContainer>
        <BoxContainer Orientation="Horizontal" Margin="0 8 0 0">
            <Button Name="DeclineButton"
                    Text="{Loc 'offer-item-window-decline'}"
                    StyleClasses="negative"
                    HorizontalExpand="True"
                    Margin="0 0 4 0" />
            <Button Name="AcceptButton"
                    Text="{Loc 'offer-item-window-accept'}"
                    StyleClasses="positive"
                    HorizontalExpand="True"
                    Margin="4 0 0 0" />
        </BoxContainer>
    </BoxContainer>
</controls:FancyWindow>
