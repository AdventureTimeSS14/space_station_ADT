<PanelContainer xmlns="https://spacestation14.io"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                HorizontalExpand="True">
    <BoxContainer Orientation="Horizontal" Margin="6 4 6 4" SeparationOverride="8">
        <TextureRect Name="Icon"
                     MinSize="32 32"
                     Stretch="KeepAspectCentered"
                     VerticalAlignment="Center" />
        <BoxContainer Orientation="Vertical" HorizontalExpand="True" SeparationOverride="2">
            <Label Name="NameLabel" StyleClasses="LabelHeading" />
            <RichTextLabel Name="DescriptionLabel" />
            <BoxContainer Name="ProgressBox" Orientation="Horizontal" SeparationOverride="6">
                <ProgressBar Name="ProgressBar"
                             HorizontalExpand="True"
                             MinHeight="10"
                             MinValue="0"
                             MaxValue="1" />
                <Label Name="ProgressLabel" MinWidth="70" Align="Right" />
            </BoxContainer>
        </BoxContainer>
    </BoxContainer>
</PanelContainer>
