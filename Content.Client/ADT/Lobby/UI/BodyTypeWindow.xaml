<controls:FancyWindow xmlns="https://spacestation14.io"
                      xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
                      Title="{Loc 'body-type-window-title'}"
                      Resizable="False">
    <BoxContainer Orientation="Vertical" Margin="8">
        <BoxContainer Name="OptionsContainer"
                      Orientation="Horizontal"
                      SeparationOverride="8"
                      HorizontalAlignment="Center" />
        <BoxContainer Orientation="Horizontal" HorizontalAlignment="Center" Margin="0 8 0 0">
            <Button Name="RotateLeftButton" Text="◀" StyleClasses="OpenRight" />
            <Button Name="RotateRightButton" Text="▶" StyleClasses="OpenLeft" />
        </BoxContainer>
    </BoxContainer>
</controls:FancyWindow>
